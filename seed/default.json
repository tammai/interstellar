{
  "version": 1,
  "topics": [
    {
      "title": "Agent Engineering",
      "definition": "Building LLM agents as software: harness design, context engineering, tool calling, memory, planning and verification loops, multi-agent orchestration, and agent frameworks (LangGraph, OpenAI Agents SDK, Claude Agent SDK, MCP servers as agent tooling). Lessons from running agents in production count. Not: using a coding agent to write your own code (that is Coding Agents in Practice), agents that operate a screen or browser (Computer-Use & Browser Agents), model launches with no agent-building angle, general chatbot news.",
      "priority": 8,
      "active": true,
      "pos_x": 0.3,
      "pos_y": 0.38
    },
    {
      "title": "Coding Agents in Practice",
      "definition": "Hands-on use of Claude Code, Cursor, Codex, Copilot agent mode and similar tools: workflows, prompting, CLAUDE.md and rules files, hooks, MCP setups, subagents, reviewing agent-written code, and how teams roll these tools out. Release notes count when they change how the tool is used day to day. Not: building your own agent product (Agent Engineering), funding or valuation news about these companies.",
      "priority": 7,
      "active": true,
      "pos_x": 0.52,
      "pos_y": 0.22
    },
    {
      "title": "Evals & LLM Observability",
      "definition": "Measuring and operating LLM systems: eval design, LLM-as-judge, regression testing for prompts and models, tracing, monitoring, cost and latency tracking per request, and tools such as Langfuse, Phoenix, Braintrust and promptfoo. Not: benchmark leaderboards for a new model release (Open Models & Self-Hosted Inference), traditional application monitoring with no LLM angle.",
      "priority": 6,
      "active": true,
      "pos_x": 0.22,
      "pos_y": 0.66
    },
    {
      "title": "Open Models & Self-Hosted Inference",
      "definition": "Open-weight model releases (Qwen, DeepSeek, Llama, Mistral, GLM, Kimi, Gemma), their benchmarks and licences, and running them yourself: vLLM, SGLang, llama.cpp, Ollama, quantisation, GPU sizing, inference cost and on-prem deployment. Deployments in banking and other regulated industries are especially relevant. Not: closed-model launches (GPT, Claude, Gemini) unless compared directly with open models, hosted API pricing (LLM Cost & Model Routing).",
      "priority": 5,
      "active": true,
      "pos_x": 0.78,
      "pos_y": 0.28
    },
    {
      "title": "AI Security & Governance",
      "definition": "Securing and governing AI systems: prompt injection, agent permissions and sandboxing, data leakage, model and package supply-chain risk, red-teaming, and AI regulation and compliance (EU AI Act, financial regulators, model-risk management in banking). Not: general cybersecurity news with no AI angle, AI-safety philosophy with nothing practical.",
      "priority": 4,
      "active": true,
      "pos_x": 0.1,
      "pos_y": 0.42
    },
    {
      "title": "LLM Cost & Model Routing",
      "definition": "The cost and routing of hosted LLM APIs: price changes, rate limits, prompt caching, batching, model routing and fallback, gateways (OpenRouter, LiteLLM, Portkey), token-efficiency techniques, and cost-versus-quality comparisons for choosing a model per task. Not: self-hosting and GPU sizing (Open Models & Self-Hosted Inference), model launches that only announce a price with no comparison.",
      "priority": 3,
      "active": true,
      "pos_x": 0.84,
      "pos_y": 0.62
    },
    {
      "title": "AI Product UX",
      "definition": "Designing the product side of AI features: generative UI, chat and agent interaction patterns, streaming and latency in the interface, showing sources and uncertainty, human-in-the-loop approval flows, onboarding and trust, and case studies of how a shipped AI feature was designed. Not: visual design trends with no AI angle, model capability news with nothing about the experience built on it.",
      "priority": 2,
      "active": true,
      "pos_x": 0.54,
      "pos_y": 0.76
    },
    {
      "title": "Computer-Use & Browser Agents",
      "definition": "Agents that operate a computer or a browser on a user's behalf: computer-use models (Claude computer use, OpenAI Operator and similar), browser automation agents (Browser Use, Playwright-driven agents, Stagehand), screen understanding, reliability and safety of agents taking real UI actions, and benchmarks such as OSWorld and WebArena. Not: ordinary test automation or scraping with no model in the loop, general agent frameworks (Agent Engineering).",
      "priority": 1,
      "active": true,
      "pos_x": 0.16,
      "pos_y": 0.16
    }
  ],
